# Private financial data — never upload the source Monefy export or the pre-OPFS DB snapshot.
# /data/ is already in .gitignore, but this repo is deployed by direct CLI upload (scripts/release.ts
# runs `vercel deploy`), so the files on disk ARE the upload — and once this file exists the CLI does
# not consult .gitignore at all. Every exclusion that matters is therefore stated here explicitly.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite*
*.xlsx

# Local secrets. The CLI's built-in defaults already skip .env.local; listed anyway so the exclusion
# does not depend on CLI behaviour. The build reads NEXT_PUBLIC_GOOGLE_CLIENT_ID from the Vercel
# project's own env, never from an uploaded file.
.env
.env*.local

# Local tooling and agent state — never a build input.
/.claude/
/.superpowers/

# Nothing below is needed to build or serve; Vercel rebuilds out/ remotely, and keeping the upload
# small also keeps it boring.
/docs/
/.impeccable/
/.playwright-mcp/
/out/
*.tsbuildinfo

# Scratch screenshots live in the repo ROOT only. This was briefly a bare `*.png`, which also
# swallowed public/icon-192.png and public/icon-512.png — the deploy came up with a manifest
# pointing at two 404s and a PWA that would not install. Anchored to the root so it can only ever
# match the throwaways it was written for.
/*.png
