# Local runtime config. Copy to `.env` (gitignored) and fill in.
# SQLite is local-first — no DB credentials needed. Add source/API secrets here as the
# ingest layer grows (e.g. Google Sheets service-account creds, bank API tokens).

# Path to the local SQLite database (defaults to data/moniflow.db when unset).
MONIFLOW_DB=data/moniflow.db

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
